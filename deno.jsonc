{
  "imports": {
    "deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.15.1/",
    "deno-slack-api/": "https://deno.land/x/deno_slack_api@2.8.0/"
  },
  "lock": false,
  "tasks": {
    "check": "deno check manifest.ts app.ts triggers/messages.ts triggers/thread_replies.ts",
    "test": "deno test tests/",
    "lint": "deno lint app.ts manifest.ts delebot/ triggers/ tests/",
    "fmt": "deno fmt app.ts manifest.ts delebot/ triggers/ tests/ deno.jsonc .slack/hooks.json"
  },
  "fmt": { "lineWidth": 90 }
}
